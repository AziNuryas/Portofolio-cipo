# ── Supabase ──────────────────────────────────────────────────
# Dashboard → Project Settings → API

# Wajib. URL publik, tetapi isi nilai asli hanya di .env.local atau env Netlify.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co

# Wajib untuk MEMBACA konten (policy SELECT tersedia untuk anon).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_GANTI_DENGAN_ANON_KEY_ANDA

# Wajib untuk MENULIS dari halaman admin.
# JANGAN pernah memakai prefix NEXT_PUBLIC_ pada kunci ini —
# kalau begitu kuncinya ikut terkirim ke browser dan siapa pun
# bisa menimpa isi situs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_GANTI_DENGAN_SERVICE_KEY_ANDA

# ── Panel admin ──────────────────────────────────────────────
# Token yang diketik di halaman /admin.
# Buat yang acak dan kuat, misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=GANTI_DENGAN_TOKEN_ACAK_ANDA

# ── WhatsApp ──────────────────────────────────────────────────
# Nomor tujuan form kontak, format internasional tanpa "+".
# Ada di src/lib/content/defaults.ts (konstanta WHATSAPP_NUMBER).
WHATSAPP_NUMBER=628969700703
