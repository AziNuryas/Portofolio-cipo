# ── Supabase ──────────────────────────────────────────────────
# Dashboard → Project Settings → API
# Site Settings → API

# Wajib. Buka juga di browser, jadi boleh di-commit.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Wajib untuk MEMBACA konten (policy SELECT tersedia untuk anon).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Wajib untuk MENULIS dari halaman admin.
# JANGAN pernah memakai prefix NEXT_PUBLIC_ pada kunci ini —
# kalau begitu kuncinya ikut terkirim ke browser dan siapa pun
# bisa menimpa isi situs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Panel admin ──────────────────────────────────────────────
# Token yang diketik di halaman /admin.
# Buat yang acak dan kuat, misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=ganti-dengan-token-acak-kuat

# ── WhatsApp ──────────────────────────────────────────────────
# Nomor tujuan form kontak, format internasional tanpa "+".
# Ada di src/lib/content/defaults.ts (konstanta WHATSAPP_NUMBER).
WHATSAPP_NUMBER=6289697007035